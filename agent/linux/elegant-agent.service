[Unit]
Description=Elegant Solution Machine Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=elegant-agent
Group=elegant-agent
ExecStart=/usr/lib/elegant-agent/elegant-agent-service
Restart=always
RestartSec=5
StateDirectory=elegant-agent
StateDirectoryMode=0700
RuntimeDirectory=elegant-agent
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/elegant-agent /run/elegant-agent

[Install]
WantedBy=multi-user.target
