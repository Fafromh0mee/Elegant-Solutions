generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
}

enum RoomCapability {
  CLASSROOM
  LAB
  MEETING
  WORKSHOP
  EVENT
}

// Per-room approval policy for ad-hoc bookings.
// Only consulted when Room.bookingEnabled is true.
enum RoomApprovalPolicy {
  AUTO
  MANUAL
}

// Standard university teaching periods.
// Slot TIMES are not stored here - see web/src/lib/academic-slots.ts.
enum AcademicSlot {
  SLOT_1
  SLOT_2
  SLOT_3
  SLOT_4
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LogAction {
  CHECK_IN
  CHECK_OUT
  ACCESS_DENIED
  TOKEN_GENERATED
  GROUP_CREATED
  USER_CREATED
  ROOM_CREATED
  ROOM_UPDATED
  USER_UPDATED
  USER_APPROVED
  USER_REJECTED
  FACE_ENROLLED
  FACE_VERIFIED
  FACE_DENIED
  SCHEDULE_ACCESS
  ROOM_BOOKING_CREATED
  ROOM_BOOKING_APPROVED
  ROOM_BOOKING_REJECTED
  ROOM_BOOKING_CANCELLED
}

// Feature 7.5: how a RoomBookingParticipant row came to be authorized.
enum BookingParticipantSource {
  SELF
  GROUP
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  hashedPassword String?
  role           Role          @default(GUEST)
  status         AccountStatus @default(APPROVED)
  studentId      String?       @unique
  faculty        String?
  major          String?
  phone          String?
  avatarUrl      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  accessTokens          AccessToken[]
  sessions              Session[]
  logs                  Log[]
  ownedGroups           Group[]                  @relation("GroupOwner")
  groupMembers          GroupMember[]
  faceProfile           FaceProfile?
  classSchedules        ClassSchedule[]
  agentLogs             AgentLog[]
  agentSessions         AgentSession[]
  maintenanceCodes      AgentMaintenanceCode[]
  activationCodes       AgentActivationCode[]
  agentAuditEvents      AgentAuditEvent[]
  roomBookings          RoomBooking[]            @relation("BookingRequester")
  bookingDecisions      RoomBooking[]            @relation("BookingDecider")
  roomClosures          RoomClosure[]            @relation("ClosureCreator")
  bookingParticipations RoomBookingParticipant[]

  @@map("users")
}

model Room {
  id          String   @id @default(cuid())
  name        String
  roomCode    String   @unique
  description String?
  capacity    Int      @default(0)
  guestAccess Boolean  @default(false)
  staffOnly   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building String?
  floor    Int?

  // Empty means "capabilities not configured", NOT "suitable for anything".
  // A room with no capabilities matches no capability filter.
  capabilities RoomCapability[] @default([])

  // Opt-in to ad-hoc self-service booking. DISTINCT from isActive:
  //   isActive       = the room is operational at all (classes, gate access).
  //   bookingEnabled = the room accepts ad-hoc RoomBookings.
  // A room can be operational for scheduled classes but not self-service bookable.
  bookingEnabled Boolean            @default(false)
  approvalPolicy RoomApprovalPolicy @default(AUTO)

  // Relations
  accessTokens        AccessToken[]
  sessions            Session[]
  logs                Log[]
  classSchedules      ClassSchedule[]
  agentMachines       AgentMachine[]
  agentSessions       AgentSession[]
  activationCodes     AgentActivationCode[]
  agentMachineSequence AgentMachineSequence?
  bookings            RoomBooking[]
  closures            RoomClosure[]
  availabilityWindows RoomAvailabilityWindow[]

  @@map("rooms")
}

model AccessToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  roomId    String
  groupId   String?
  validFrom DateTime
  validTo   DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@map("access_tokens")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique @default(cuid())
  ownerId   String
  createdAt DateTime @default(now())

  // Relations
  owner               User                     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members             GroupMember[]
  accessTokens        AccessToken[]
  // Provenance only on RoomBookingParticipant - never read for authorization once a booking exists.
  bookingParticipants RoomBookingParticipant[]

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model Session {
  id                String        @id @default(cuid())
  userId            String
  roomId            String
  checkIn           DateTime      @default(now())
  checkOut          DateTime?
  scheduledCheckOut DateTime?
  status            SessionStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Log {
  id        String    @id @default(cuid())
  userId    String?
  roomId    String?
  action    LogAction
  details   String?
  createdAt DateTime  @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@map("logs")
}

model ClassSchedule {
  id          String   @id @default(cuid())
  userId      String
  roomId      String
  dayOfWeek   Int // 0=Sunday … 6=Saturday
  startTime   String // "HH:MM" 24-hour
  endTime     String // "HH:MM" 24-hour
  section     String?
  subjectName String?
  subjectCode String?
  semester    String?
  createdAt   DateTime @default(now())

  // Nullable on purpose: rows whose times do not align to the academic grid
  // keep only startTime/endTime. Consumers must handle null.
  slot AcademicSlot?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId, dayOfWeek, startTime, endTime, semester])
  @@index([userId, semester, dayOfWeek, startTime, endTime])
  @@index([userId, semester, subjectCode])
  @@index([roomId, semester, dayOfWeek, slot])
  @@map("class_schedules")
}

model FaceProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  embedding    Float[]
  modelVersion String   @default("buffalo_l")
  qualityScore Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("face_profiles")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model AgentMachine {
  id          String    @id @default(cuid())
  machineCode String    @unique
  hostname    String
  roomId      String?
  platform    String?
  agentVersion String?
  apiKey      String    @unique @default(cuid())
  lastSeen    DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  room      Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  agentLogs AgentLog[]
  agentSessions AgentSession[]
  maintenanceCodes AgentMaintenanceCode[]
  agentAuditEvents AgentAuditEvent[]

  @@map("agent_machines")
}

model AgentSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  machineId String
  roomId    String
  issuedAt  DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  status    String   @default("ACTIVE")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine AgentMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  room   Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([machineId, status, expiresAt])
  @@index([userId, machineId, status])
  @@map("agent_sessions")
}

model AgentMaintenanceCode {
  id          String   @id @default(cuid())
  codeHash    String   @unique
  machineId   String
  action      String
  createdById String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  machine   AgentMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  auditEvents AgentAuditEvent[]

  @@index([machineId, action, expiresAt])
  @@map("agent_maintenance_codes")
}

model AgentActivationCode {
  id                  String   @id @default(cuid())
  codeHash            String   @unique
  roomId              String
  reservedMachineCode String   @unique
  createdById         String
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?
  revokedAt           DateTime?

  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  auditEvents AgentAuditEvent[]

  @@index([roomId, expiresAt])
  @@map("agent_activation_codes")
}

model AgentMachineSequence {
  id               String   @id @default(cuid())
  roomId           String   @unique
  lastIssuedNumber Int      @default(0)
  updatedAt        DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("agent_machine_sequences")
}

model AgentAuditEvent {
  id                 String   @id @default(cuid())
  event              String
  machineId          String?
  userId             String?
  maintenanceCodeId  String?
  activationCodeId   String?
  details            String?
  createdAt          DateTime @default(now())

  machine         AgentMachine?          @relation(fields: [machineId], references: [id], onDelete: SetNull)
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  maintenanceCode AgentMaintenanceCode? @relation(fields: [maintenanceCodeId], references: [id], onDelete: SetNull)
  activationCode  AgentActivationCode?  @relation(fields: [activationCodeId], references: [id], onDelete: SetNull)

  @@index([machineId, createdAt])
  @@index([event, createdAt])
  @@map("agent_audit_events")
}

model AgentLog {
  id          String   @id @default(cuid())
  machineId   String
  userId      String?
  activeApp   String?
  activeTitle String?
  riskLevel   String   @default("NORMAL")
  createdAt   DateTime @default(now())

  machine AgentMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([machineId, createdAt])
  @@map("agent_logs")
}

model AgentBlacklist {
  id        String   @id @default(cuid())
  pattern   String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("agent_blacklist")
}

// An ad-hoc room booking.
//
// DELIBERATELY UNRELATED to ClassSchedule. A scheduled class is not a booking and
// must never enter the approval queue: the queue is `RoomBooking status = PENDING`,
// and no class_schedules row can appear in this table. The two domains share only
// the AcademicSlot vocabulary.
model RoomBooking {
  id             String        @id @default(cuid())
  roomId         String
  userId         String
  // The Asia/Bangkok calendar day booked. DATE has no timezone by design.
  date           DateTime      @db.Date
  // Expected number of users, for capacity checks.
  partySize      Int
  purpose        String?
  status         BookingStatus @default(PENDING)
  // null together with APPROVED means auto-approved under an AUTO room policy.
  decidedById    String?
  decidedAt      DateTime?     @db.Timestamptz(3)
  decisionReason String?
  cancelledAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  // Relations
  // RESTRICT, not Cascade: a booking is historical/audit-relevant transactional data.
  // Deleting a Room or User must not silently erase booking history. Rooms are
  // disabled with isActive; users should be deactivated, not deleted.
  room         Room                     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user         User                     @relation("BookingRequester", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy    User?                    @relation("BookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  slots        RoomBookingSlot[]
  participants RoomBookingParticipant[]

  @@index([roomId, date, status])
  @@index([userId, date])
  @@index([status, createdAt])
  @@map("room_bookings")
}

// One academic slot inside a booking. A booking covers one or more.
//
// roomId/date are NOT duplicated here - they are derived through the parent booking,
// so there is no way for them to drift out of sync.
model RoomBookingSlot {
  id        String       @id @default(cuid())
  bookingId String
  slot      AcademicSlot
  // Resolved from the booking date + slot at creation time, in Asia/Bangkok.
  // Stored so a later edit to ACADEMIC_SLOTS cannot rewrite what a past booking meant,
  // and so the gate can authorize with a plain timestamp comparison.
  startAt   DateTime     @db.Timestamptz(3)
  endAt     DateTime     @db.Timestamptz(3)

  // Relations
  booking RoomBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, slot])
  @@map("room_booking_slots")
}

// Feature 7.5: the snapshot of WHO a RoomBooking authorizes, taken at creation time.
//
// This is deliberately NOT derived from live GroupMember rows. Once a booking exists,
// its participant set is frozen here; later Group membership changes (joins, and any
// future removals) never retroactively change what an existing booking authorizes.
// groupId is provenance only ("this row came from Group X") - it must never be
// re-queried to decide who is authorized. The creator (RoomBooking.userId) is always
// also represented here as a participant row.
model RoomBookingParticipant {
  id        String                   @id @default(cuid())
  bookingId String
  userId    String
  source    BookingParticipantSource
  groupId   String?
  createdAt DateTime                 @default(now())

  // Relations
  // Cascade: a participant row has no meaning without its booking (mirrors RoomBookingSlot).
  booking RoomBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Restrict, matching RoomBooking.userId: users are deactivated, not deleted, so a
  // participant row must never silently disappear because a user row was removed.
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  // SetNull, matching AccessToken.groupId: deleting a Group only clears provenance here,
  // it never touches the booking or this participant row.
  group   Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([bookingId, userId])
  // The index a future Gate entitlement resolver needs: "does this user participate in
  // an APPROVED booking covering this room right now?"
  @@index([userId])
  @@map("room_booking_participants")
}

// Allowed booking day+slot for a room. FAIL-CLOSED:
// a room with bookingEnabled = true but NO rows here is "not configured" and is
// therefore NOT bookable. All days / all slots must be represented explicitly.
model RoomAvailabilityWindow {
  id        String       @id @default(cuid())
  roomId    String
  dayOfWeek Int // 0=Sunday … 6=Saturday, same convention as ClassSchedule
  slot      AcademicSlot

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, dayOfWeek, slot])
  @@index([roomId])
  @@map("room_availability_windows")
}

// Temporary closure / maintenance. Distinct from Room.isActive, which is permanent,
// and from the site-wide MAINTENANCE_MODE SystemSetting.
model RoomClosure {
  id          String         @id @default(cuid())
  roomId      String
  // Inclusive Asia/Bangkok calendar dates.
  startDate   DateTime       @db.Date
  endDate     DateTime       @db.Date
  // Empty means the whole date range is closed; otherwise only these slots are.
  slots       AcademicSlot[] @default([])
  reason      String?
  createdById String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  // Relations
  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ClosureCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([roomId, startDate, endDate])
  @@map("room_closures")
}
