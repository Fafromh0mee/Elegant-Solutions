# Copy to .env.pilot on the pilot host and replace every placeholder.
# Use a URL-safe PostgreSQL password because Compose derives DATABASE_URL below.
POSTGRES_USER=elegant
POSTGRES_DB=elegant_solutions
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password

AUTH_SECRET=replace_with_a_long_random_auth_secret
AUTH_URL=https://pilot.example.com
APP_ENVIRONMENT=pilot
TZ=Asia/Bangkok
WEB_PORT=3000
AGENT_INSTALLER_DIR=/app/agent-installers

# Optional Google OAuth configuration, if enabled for this pilot.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
